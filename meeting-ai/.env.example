# Hugging Face Token для pyannote.audio (обязательно)
# Получить можно здесь: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Хост Ollama (по умолчанию)
OLLAMA_HOST=http://localhost:11434

# Модель Ollama для суммаризации
OLLAMA_MODEL=qwen2.5:7b-instruct

# Максимальный размер загружаемого файла в МБ
MAX_FILE_SIZE_MB=2048

# Порт сервиса
PORT=8000
